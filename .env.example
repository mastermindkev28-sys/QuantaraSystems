# ── ClickUp CRM ──────────────────────────────────────────────────────────────
# Run scripts/setup-clickup-crm.mjs to generate all values below automatically.
CLICKUP_API_TOKEN=pk_...
CLICKUP_LIST_ID=

# Custom field IDs (created by setup script)
CLICKUP_FIELD_EMAIL=
CLICKUP_FIELD_PHONE=
CLICKUP_FIELD_SCHEDULED_TIME=
CLICKUP_FIELD_CHALLENGE=
CLICKUP_FIELD_IMPACT=
CLICKUP_FIELD_DURATION=
CLICKUP_FIELD_IDEAL=
CLICKUP_FIELD_IMPORTANCE=
CLICKUP_FIELD_READINESS=

# ── Calendly Webhook ──────────────────────────────────────────────────────────
# A strong random secret — must match what you provide when registering the
# Calendly webhook via scripts/register-calendly-webhook.mjs.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDLY_WEBHOOK_SECRET=
